# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/

# Database files (per-project, not tracked)
*.sqlite
*.sqlite-wal
*.sqlite-shm

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Test cache
.pytest_cache/

# Agent-local state (contents ignored, but project_id is committable:
# a directory itself can't be excluded and then negated file-by-file)
.agents/*
!/.agents/project_id
